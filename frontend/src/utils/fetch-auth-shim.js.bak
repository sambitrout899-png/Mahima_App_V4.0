  }

  if (!res.ok) {
    const err = new Error(
      `HTTP ${res.status} ${res.statusText || ""} – ${text || "Request failed"}`
    );

    // 🔥 CRITICAL: attach helpers to mimic fetch response
    err.text = () => Promise.resolve(text);
    err.json = () => Promise.resolve(data);

    throw err;
  }

  // 🔥 RETURN OBJECT THAT SUPPORTS BOTH STYLES
  return {
    data,
    text: () => Promise.resolve(text),
    json: () => Promise.resolve(data),
  };
}*/
export async function apiFetchJson(input, init = {}) {
  const res = await apiFetch(input, init);

  const text = await res.text().catch(() => "");

  let data = null;

  try {
    data = text ? JSON.parse(text) : null;
  } catch {
    data = text;
  }

  // ✅ RETURN FULL RESPONSE-LIKE OBJECT
  return {
    ok: res.ok,
    status: res.status,
    statusText: res.statusText,
    data,
    text: () => Promise.resolve(text),
    json: () => Promise.resolve(data),
  };
}

/* ---------------- AUTH APIs ---------------- */
export function register(data) {
  return apiFetchJson("/auth/register", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data),
  });
}

export function login(data) {
  return apiFetchJson("/auth/login", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(data),
  });
}
