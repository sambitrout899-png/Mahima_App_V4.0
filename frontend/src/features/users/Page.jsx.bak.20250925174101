const modalOverlay = {
  position: "fixed", left: 0, top: 0, right: 0, bottom: 0,
  background: "rgba(0,0,0,0.35)",
  display: "flex", alignItems: "center", justifyContent: "center", zIndex: 9999
};
const modal = {
  background: "white", padding: 20, borderRadius: 8, width: 560, maxWidth: "95%", boxShadow: "0 10px 30px rgba(0,0,0,0.15)"
};
const inputStyle = { width: "100%", padding: "8px 10px", borderRadius: 6, border: "1px solid #ddd", marginTop: 6 };








