
function isIdKey(k) {
  if (!k) return false;
  const s = String(k).toLowerCase();
  return s === 'id' || s.endsWith('id');
}

function DetectFields(obj) {
  if (!obj || typeof obj !== 'object') return ['id','name'];
  return Object.keys(obj);
}
import React, { useEffect, useState } from "react";


/* --- auto-inserted IdField: show readonly ID only when editing (form.id) --- */
const IdField = ({ form }) => {
  if (!form || !form.id) return null;
  return null;
};


/*
  Full Users Page
  - Expects API endpoints:
    GET  /api/users?search=&page=1&limit=50      -> { total, page, limit, items: [...] } OR an array [...]
    POST /api/users                              -> create user
    PUT  /api/users/:id                          -> update user
    DELETE /api/users/:id                        -> delete user
  - The component is intentionally self-contained and defensive about response shape.
*/

const API_BASE = "http://187.127.132.149:5001/api";

function normalizeResponse(res) {
  // Accept array or { items: [], total, page, limit } or { data: [] }
  const isArray = Array.isArray(res);
  const items = isArray ? res : (res && (res.items || res.data || [])) || [];
  const meta = {
    total: !isArray ? (res?.total ?? items.length) : items.length,
    page: !isArray ? (res?.page ?? 1) : 1,
    limit: !isArray ? (res?.limit ?? items.length) : items.length,
  };
  return { items, meta };
}

function defaultForm() {
  return {
    id: null,
    displayName: "",
    username: "",
    email: "",
    role: "member",
    joinDate: new Date().toISOString(),
    lastLogin: null,
    teams: null,
  };
}

export default function UsersPage() {
  const [users, setUsers] = useState([]);
  const [meta, setMeta] = useState({ total: 0, page: 1, limit: 50 });
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
   // roles dropdown values (added)
   const [roles, setRoles] = useState(["member", "admin", "leader"]);
   // If you prefer, fetch roles from server using useEffect:
   // useEffect(() => { (async () => {
   //   try { const res = await fetch(`${API_BASE}/api/roles`); if (res.ok) setRoles(await res.json()); } catch(e){console.warn(e)}
   // })(); }, []);


  // Modal form
  const [showModal, setShowModal] = useState(false);
  const [form, setForm] = useState(defaultForm());
  const [saving, setSaving] = useState(false);

  // Confirmation delete
  const [deletingId, setDeletingId] = useState(null);
  const [deleteLoading, setDeleteLoading] = useState(false);

  const fetchUsers = async (page = 1, limit = 50, searchTerm = "") => {
    try {
      setLoading(true);
      setError(null);

      const q = new URLSearchParams({ search: searchTerm ?? "", page: String(page), limit: String(limit) });
      const resp = await fetch(`${API_BASE}/users?${q.toString()}`, { method: "GET" });
      if (!resp.ok) {
        const txt = await resp.text();
        throw new Error(`HTTP ${resp.status} - ${txt}`);
      }
      const data = await resp.json();
      const { items, meta } = normalizeResponse(data);
      setUsers(items);
      setMeta(meta);
    } catch (err) {
      console.error("fetchUsers error:", err);
      setError(String(err));
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchUsers(meta.page, meta.limit, search);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []); // initial load

  // Helpers for pagination
  const gotoPage = (p) => {
    const page = Math.max(1, p);
    setMeta(prev => ({ ...prev, page }));
    fetchUsers(page, meta.limit, search);
  };

  const onSearch = (evt) => {
    evt?.preventDefault?.();
    const q = search;
    // reset to page 1 on search
    setMeta(prev => ({ ...prev, page: 1 }));
    fetchUsers(1, meta.limit, q);
  };

  // Open Add modal
  const openAdd = () => {
    setForm(defaultForm());
    setShowModal(true);
  };
    // Open Create modal
const openCreate = () => {
     setForm({
       displayName: "",
       username: "",
       email: "",
       role: "member",   // default role
       joinDate: "",
       lastLogin: null,
       teams: null
     });
     setShowModal(true);
   };
  // Open Edit modal
  const openEdit = (u) => {
    // unify field names - accept both displayName or name
    setForm({
      id: u.id || null,
      displayName: u.displayName ?? u.name ?? "",
      username: u.username ?? "",
      email: u.email ?? "",
      role: u.role ?? "member",
      joinDate: u.joinDate ?? new Date().toISOString(),
      lastLogin: u.lastLogin ?? null,
      teams: u.teams ?? null,
    });
    setShowModal(true);
  };

  // Save (create or update)
  const saveUser = async (e) => {
    e?.preventDefault?.();
    setSaving(true);
    setError(null);
	
	

    try {
      const payload = {
        displayName: form.displayName,
        username: form.username,
        email: form.email,
        role: form.role,
        joinDate: form.joinDate,
        lastLogin: form.lastLogin,
        teams: form.teams,
      };

      let resp;
      if (form.id) {
        resp = await fetch(`${API_BASE}/users/${form.id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...payload, id: form.id }),
        });
      } else {
        resp = await fetch(`${API_BASE}/users`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
      }

      if (!resp.ok) {
        const txt = await resp.text();
        throw new Error(`HTTP ${resp.status} - ${txt}`);
      }

      // refresh list after save (go to first page to see new records usually)
      setShowModal(false);
      await fetchUsers(1, meta.limit, search);
    } catch (err) {
      console.error("saveUser error:", err);
      setError(String(err));
      alert("Save failed: " + String(err));
    } finally {
      setSaving(false);
    }
  };

  // Delete
  const confirmDelete = (id) => {
    if (!id) return;
    if (!confirm("Delete this user? This action cannot be undone.")) return;
    doDelete(id);
  };

  const doDelete = async (id) => {
    try {
      setDeleteLoading(true);
      const resp = await fetch(`${API_BASE}/users/${id}`, { method: "DELETE" });
      if (!resp.ok) {
        const txt = await resp.text();
        throw new Error(`HTTP ${resp.status} - ${txt}`);
      }
      // refresh current page (if deletion left page empty, move back one)
      const newTotal = Math.max(0, meta.total - 1);
      const pageCount = Math.max(1, Math.ceil(newTotal / meta.limit));
      const newPage = Math.min(meta.page, pageCount);
      await fetchUsers(newPage, meta.limit, search);
    } catch (err) {
      console.error("doDelete error:", err);
      alert("Delete failed: " + String(err));
    } finally {
      setDeleteLoading(false);
    }
  };

  // Form input handler
  const setField = (k, v) => setForm(prev => ({ ...prev, [k]: v }));

  // Render helpers
  const start = (meta.page - 1) * meta.limit + 1;
  const end = Math.min(meta.total, meta.page * meta.limit);

  return (
    <div style={{ padding: 24 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 18 }}>
        <h1 style={{ margin: 0 }}>Users</h1>
        <div>
          <button onClick={openAdd} style={primaryBtn}>Add Record</button>
        </div>
      </div>

      <form onSubmit={onSearch} style={{ marginBottom: 12, display: "flex", gap: 8, alignItems: "center" }}>`r`n    
        <input
          placeholder="Search by name, username, email..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{ padding: 8, minWidth: 320, borderRadius: 6, border: "1px solid #ddd" }}
        />
        <button type="submit" style={secondaryBtn}>Search</button>
        <button type="button" onClick={() => { setSearch(""); fetchUsers(1, meta.limit, ""); }} style={linkBtn}>Clear</button>
      </form>

      {error && <div style={{ color: "red", marginBottom: 8 }}>{error}</div>}

      <div style={{ overflowX: "auto", background: "white", borderRadius: 6 }}>
        <table style={{ width: "100%", borderCollapse: "collapse" }}>
          <thead>
            <tr style={{ background: "#fdecec" }}>
              <th style={thStyle}>id</th>
              <th style={thStyle}>name</th>
              <th style={thStyle}>username</th>
              <th style={thStyle}>email</th>
              <th style={thStyle}>Actions</th>
            </tr>
          </thead>
          <tbody>
            {loading ? (
              <tr><td colSpan={5} style={tdStyle}>Loading...</td></tr>
            ) : users.length === 0 ? (
              <tr><td colSpan={5} style={tdStyle}>No users</td></tr>
            ) : (
              users.map(u => (
                <tr key={u.id}>
                  <td style={tdStyle}>{u.id}</td>
                  <td style={tdStyle}>{u.name ?? u.displayName ?? u.username ?? ""}</td>
                  <td style={tdStyle}>{u.username ?? ""}</td>
                  <td style={tdStyle}>{u.email ?? ""}</td>
                  <td style={{ ...tdStyle, whiteSpace: "nowrap" }}>
                    <button onClick={() => openEdit(u)} style={smallBtn}>Edit</button>
                    <button onClick={() => confirmDelete(u.id)} style={{ ...smallBtn, marginLeft: 8, background: "#f44336", color: "white" }}>
                      {deleteLoading && deletingId === u.id ? "Deleting..." : "Delete"}
                    </button>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
	  
  <div style={{ marginBottom: 10 }}>
  <label htmlFor="roleSelect" style={{ display: "block", marginBottom: 6 }}>Role</label>
  <select
    id="roleSelect"
    name="role"
    value={form.role ?? ""}
    onChange={(e) => setForm(prev => ({ ...prev, role: e.target.value }))}
    aria-label="Role"
    style={{ width: "100%", padding: 8, borderRadius: 6, border: "1px solid #e6e6e6", fontSize: 14 }}
  >
    <option value="">-- select role --</option>
    {roles.map(r => (
      typeof r === "string" ? (
        <option key={r} value={r}>{r}</option>
      ) : (
        <option key={r.value} value={r.value}>{r.label}</option>
      )
    ))}
  </select>
</div>


      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginTop: 12 }}>
        <div style={{ color: "#666" }}>
          Showing {users.length === 0 ? 0 : `${start}–${end}`} of {meta.total}
        </div>

        <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
          <button onClick={() => gotoPage(1)} style={navBtn} disabled={meta.page <= 1}>« First</button>
          <button onClick={() => gotoPage(meta.page - 1)} style={navBtn} disabled={meta.page <= 1}>‹ Prev</button>
          <span>Page {meta.page}</span>
          <button onClick={() => gotoPage(meta.page + 1)} style={navBtn} disabled={meta.page * meta.limit >= meta.total}>Next ›</button>
          <button onClick={() => gotoPage(Math.ceil(meta.total / meta.limit))} style={navBtn} disabled={meta.page * meta.limit >= meta.total}>Last »</button>
        </div>
      </div>

      {/* Modal */}
      {showModal && (
    

        <div style={modalOverlay}>
  
          <div style={modal}>
            <h3 style={{ marginTop: 0 }}>{form.id ? "Edit User" : "Add User"}</h3>
            <form onSubmit={saveUser}>`r`n    
              <div style={{ display: "grid", gap: 8 }}>
                <label>
                  Display name
                  <input value={form.displayName} onChange={(e) => setField("displayName", e.target.value)} style={inputStyle} />
                </label>
                <label>
                  Username
                  <input value={form.username} onChange={(e) => setField("username", e.target.value)} style={inputStyle} />
                </label>
                <label>
                  Email
                  <input value={form.email} onChange={(e) => setField("email", e.target.value)} style={inputStyle} />
                </label>
                <label>
                  Role
                  <select value={form.role} onChange={(e) => setField("role", e.target.value)} style={inputStyle}>
                    <option value="member">member</option>
                    <option value="admin">admin</option>
                  </select>
                </label>
                <label>
                  Join Date (ISO)
                  <input value={form.joinDate} onChange={(e) => setField("joinDate", e.target.value)} style={inputStyle} />
                </label>
              </div>

              <div style={{ marginTop: 12, display: "flex", gap: 8, justifyContent: "flex-end" }}>
                <button type="button" onClick={() => setShowModal(false)} style={secondaryBtn}>Cancel</button>
                <button type="submit" disabled={saving} style={primaryBtn}>{saving ? "Saving..." : "Save"}</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

/* --- styles --- */
const thStyle = { textAlign: "left", padding: "12px 16px", color: "#c33", fontWeight: 600 };
const tdStyle = { padding: "12px 16px", borderBottom: "1px solid rgba(0,0,0,0.05)" };
