import React, { useEffect, useState } from "react";
import axios from "axios";
import html2pdf from "html2pdf.js";

const PRIMARY = "bg-amber-500";
const BTN = "bg-amber-500 text-white px-4 py-2 rounded";
const CARD = "bg-white p-4 rounded shadow";

const CostsPage = () => {
  const [expenses, setExpenses] = useState([]);
  const [accounts, setAccounts] = useState([]);
  const [balances, setBalances] = useState([]);
  const [ledger, setLedger] = useState([]);

  const [selectedAccount, setSelectedAccount] = useState(null);
  const [view, setView] = useState("dashboard");

  const [expenseModal, setExpenseModal] = useState(false);
  const [coaModal, setCoaModal] = useState(false);
  const [editBalance, setEditBalance] = useState(null);

  const [saving, setSaving] = useState(false);

  useEffect(() => {
    fetchAll();
  }, []);

  const fetchAll = async () => {
    const [e, a, b] = await Promise.all([
      axios.get("/api/expenses"),
      axios.get("/api/accounting/accounts"),
      axios.get("/api/accounting/balances"),
    ]);
    setExpenses(e.data || []);
    setAccounts(a.data || []);
    setBalances(b.data || []);
  };

  const loadLedger = async (acc) => {
    setSelectedAccount(acc);
    const res = await axios.get(`/api/accounting/ledger/${acc.id}`);
    setLedger(res.data || []);
    setView("ledger");
  };

  // 🔥 CENTRAL SAVE HANDLER
  const handleExpenseSave = async (payload) => {
    try {
      setSaving(true);
      await axios.post("/api/expenses", payload);
      await fetchAll();
      setExpenseModal(false);
    } finally {
      setSaving(false);
    }
  };

  const exportPDF = () => {
    const element = document.getElementById("report");

    html2pdf().set({
      margin: 10,
      filename: "Mahima_Report.pdf",
      html2canvas: { scale: 2 },
      jsPDF: { unit: "mm", format: "a4" },
    }).from(element).save();
  };

  // ===== CALCULATIONS =====
  const revenue = balances.filter(b => b.type === "INCOME")
    .reduce((s, b) => s + b.balance, 0);

  const expensesTotal = balances.filter(b => b.type === "EXPENSE")
    .reduce((s, b) => s + b.balance, 0);

  const ebidta = revenue - expensesTotal;

  return (
    <div className="p-6 bg-gray-100 min-h-screen">

      {/* HEADER */}
      <div className="flex justify-between mb-4">
        <h1 className="text-2xl font-bold text-gray-700">Mahima Accounting</h1>

        <div className="flex gap-2">
          <button onClick={() => window.print()} className="bg-gray-700 text-white px-3 py-1 rounded">Print</button>
          <button onClick={exportPDF} className="bg-gray-700 text-white px-3 py-1 rounded">PDF</button>
          <button onClick={() => setExpenseModal(true)} className={BTN}>+ Expense</button>
          <button onClick={() => setCoaModal(true)} className="bg-blue-500 text-white px-3 py-1 rounded">+ Account</button>
        </div>
      </div>

      {/* NAV */}
      <div className="flex gap-2 mb-4">
        {["dashboard", "coa", "ledger", "journal", "trial", "pnl", "balance"].map(v => (
          <button key={v}
            onClick={() => setView(v)}
            className={`px-3 py-1 rounded ${view === v ? PRIMARY + " text-white" : "bg-gray-200"}`}>
            {v.toUpperCase()}
          </button>
        ))}
      </div>

      {/* DASHBOARD */}
      {view === "dashboard" && (
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {balances.map(b => (
            <div key={b.accountId}
              onClick={() => setEditBalance(b)}
              className={`${CARD} cursor-pointer`}>
              <div>{b.accountName}</div>
              <div className="font-bold text-lg">₹{b.balance}</div>
            </div>
          ))}
        </div>
      )}

      {/* COA */}
      {view === "coa" && (
        <div className={CARD}>
          {["ASSET", "LIABILITY", "INCOME", "EXPENSE"].map(type => (
            <div key={type}>
              <h4 className="font-semibold">{type}</h4>
              {accounts.filter(a => a.type === type).map(a => (
                <div key={a.id}>{a.name}</div>
              ))}
            </div>
          ))}
        </div>
      )}

      {/* LEDGER */}
      {view === "ledger" && (
        <div className="grid grid-cols-3 gap-4">
          <div className={CARD}>
            {accounts.map(a => (
              <div key={a.id} onClick={() => loadLedger(a)}>{a.name}</div>
            ))}
          </div>

          <div className={`${CARD} col-span-2`}>
            {ledger.map((l, i) => (
              <div key={i} className="flex justify-between border-b py-1">
                <span>{l.description}</span>
                <span>Dr {l.debit} | Cr {l.credit}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* PNL */}
      {view === "pnl" && (
        <div className={CARD}>
          <div>Revenue ₹{revenue}</div>
          <div>Expenses ₹{expensesTotal}</div>
          <div className="font-bold">EBITDA ₹{ebidta}</div>
        </div>
      )}

      {/* BALANCE */}
      {view === "balance" && (
        <div id="report" className={CARD}>
          <img src="/logo.png" className="h-10 mb-2" />
          <h3>Balance Sheet</h3>

          {balances.map(b => (
            <div key={b.accountId} className="flex justify-between">
              <span>{b.accountName}</span>
              <span>₹{b.balance}</span>
            </div>
          ))}
        </div>
      )}

      {/* MODALS */}
      {expenseModal && (
        <ExpenseModal
          onClose={() => setExpenseModal(false)}
          onSave={handleExpenseSave}
          saving={saving}
          accounts={accounts}
        />
      )}

      {coaModal && (
        <AccountModal onClose={() => setCoaModal(false)} onSaved={fetchAll} />
      )}

      {editBalance && (
        <BalanceModal data={editBalance} onClose={() => setEditBalance(null)} onSaved={fetchAll} />
      )}

    </div>
  );
};

export default CostsPage;


// ================= MODALS =================

// EXPENSE
const ExpenseModal = ({ onClose, onSave, saving, accounts }) => {
  const [form, setForm] = useState({});

  const submit = (e) => {
    e.preventDefault();
    onSave(form);
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <form onSubmit={submit} className="bg-white p-5 rounded w-96 space-y-2">
        <input placeholder="Desc" onChange={e => setForm({ ...form, description: e.target.value })} />
        <input type="number" placeholder="Amount" onChange={e => setForm({ ...form, amount: e.target.value })} />

        <select onChange={e => setForm({ ...form, debitAccountId: e.target.value })}>
          {accounts.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
        </select>

        <select onChange={e => setForm({ ...form, creditAccountId: e.target.value })}>
          {accounts.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}
        </select>

        <button className={BTN}>{saving ? "Saving..." : "Save"}</button>
      </form>
    </div>
  );
};

// ACCOUNT
const AccountModal = ({ onClose, onSaved }) => {
  const [name, setName] = useState("");
  const [type, setType] = useState("ASSET");

  const save = async () => {
    await axios.post("/api/accounting/accounts", { name, type });
    onSaved();
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <div className="bg-white p-5 rounded">
        <input onChange={e => setName(e.target.value)} />
        <select onChange={e => setType(e.target.value)}>
          <option>ASSET</option><option>EXPENSE</option>
        </select>
        <button onClick={save}>Save</button>
      </div>
    </div>
  );
};

// BALANCE
const BalanceModal = ({ data, onClose, onSaved }) => {
  const [amount, setAmount] = useState(data.balance);

  const save = async () => {
    await axios.post("/api/accounting/update-balance", {
      accountId: data.accountId,
      amount,
    });
    onSaved();
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <div className="bg-white p-5 rounded">
        <input value={amount} onChange={e => setAmount(e.target.value)} />
        <button onClick={save}>Save</button>
      </div>
    </div>
  );
};
