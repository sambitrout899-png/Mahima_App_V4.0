// src/pages/CostsPage.jsx
import React, { useEffect, useState } from "react";
import axios from "axios";
import html2pdf from "html2pdf.js";

const PRIMARY = "bg-amber-500";
const BTN = "bg-amber-500 text-white px-4 py-2 rounded";
const CARD = "bg-white p-4 rounded shadow";

const CostsPage = () => {
  const [accounts, setAccounts] = useState([]);
  const [balances, setBalances] = useState([]);
  const [view, setView] = useState("dashboard");

  const [modalOpen, setModalOpen] = useState(false);
  const [coaModal, setCoaModal] = useState(false);
  const [editBalance, setEditBalance] = useState(null);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    const [a, b] = await Promise.all([
      axios.get("/api/accounting/accounts"),
      axios.get("/api/accounting/balances"),
    ]);
    setAccounts(a.data || []);
    setBalances(b.data || []);
  };

  const exportPDF = () => {
    const element = document.getElementById("report");

    html2pdf().set({
      margin: 10,
      filename: "Mahima_Report.pdf",
      html2canvas: { scale: 2 },
      jsPDF: { unit: "mm", format: "a4" },
    }).from(element).save();
  };

  return (
    <div className="p-6 bg-gray-100 min-h-screen">

      {/* HEADER */}
      <div className="flex justify-between mb-4">
        <h1 className="text-2xl font-bold text-gray-700">Mahima Accounting</h1>

        <div className="flex gap-2">
          <button onClick={() => window.print()} className="bg-gray-700 text-white px-3 py-1 rounded">Print</button>
          <button onClick={exportPDF} className="bg-gray-700 text-white px-3 py-1 rounded">PDF</button>
          <button onClick={() => setCoaModal(true)} className="bg-blue-500 text-white px-3 py-1 rounded">+ Account</button>
        </div>
      </div>

      {/* NAV */}
      <div className="flex gap-2 mb-4">
        {["dashboard", "coa", "balance"].map(v => (
          <button key={v}
            onClick={() => setView(v)}
            className={`px-3 py-1 rounded ${view === v ? PRIMARY + " text-white" : "bg-gray-200"}`}>
            {v.toUpperCase()}
          </button>
        ))}
      </div>

      {/* DASHBOARD */}
      {view === "dashboard" && (
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {balances.map(b => (
            <div key={b.accountId}
              onClick={() => setEditBalance(b)}
              className={`${CARD} cursor-pointer`}>
              <div>{b.accountName}</div>
              <div className="font-bold text-lg">₹{b.balance}</div>
            </div>
          ))}
        </div>
      )}

      {/* CHART OF ACCOUNTS */}
      {view === "coa" && (
        <div className={CARD}>
          <h3 className="font-semibold mb-3">Chart of Accounts</h3>

          {["ASSET", "LIABILITY", "INCOME", "EXPENSE"].map(type => (
            <div key={type} className="mb-3">
              <h4 className="font-semibold text-gray-600">{type}</h4>

              {accounts.filter(a => a.type === type).map(a => (
                <div key={a.id} className="flex justify-between pl-4">
                  <span>{a.name}</span>
                </div>
              ))}
            </div>
          ))}
        </div>
      )}

      {/* BALANCE SHEET */}
      {view === "balance" && (
        <div id="report" className={`${CARD} p-8`}>

          <div className="flex items-center gap-3 mb-4">
            <img src="/logo.png" alt="Mahima" className="h-10" />
            <div className="text-xl font-bold">Mahima Ministries</div>
          </div>

          <h2 className="text-center font-bold mb-6">Balance Sheet</h2>

          <div className="grid grid-cols-2 gap-10">

            <div>
              <h4 className="font-semibold border-b mb-2">Assets</h4>
              {balances.filter(b => b.type === "ASSET").map(b => (
                <div key={b.accountId} className="flex justify-between">
                  <span>{b.accountName}</span>
                  <span>₹{b.balance}</span>
                </div>
              ))}
            </div>

            <div>
              <h4 className="font-semibold border-b mb-2">Expenses</h4>
              {balances.filter(b => b.type === "EXPENSE").map(b => (
                <div key={b.accountId} className="flex justify-between">
                  <span>{b.accountName}</span>
                  <span>₹{b.balance}</span>
                </div>
              ))}
            </div>

          </div>
        </div>
      )}

      {/* ADD ACCOUNT MODAL */}
      {coaModal && (
        <AccountModal onClose={() => setCoaModal(false)} onSaved={fetchData} />
      )}

      {/* EDIT BALANCE */}
      {editBalance && (
        <BalanceModal
          data={editBalance}
          onClose={() => setEditBalance(null)}
          onSaved={fetchData}
        />
      )}

    </div>
  );
};

export default CostsPage;



// 🔥 ADD ACCOUNT
const AccountModal = ({ onClose, onSaved }) => {
  const [name, setName] = useState("");
  const [type, setType] = useState("ASSET");

  const save = async () => {
    await axios.post("/api/accounting/accounts", { name, type });
    onSaved();
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <div className="bg-white p-5 rounded w-80 space-y-2">

        <h3>Add Account</h3>

        <input className="w-full border p-2"
          placeholder="Account Name"
          onChange={e => setName(e.target.value)} />

        <select className="w-full border p-2"
          onChange={e => setType(e.target.value)}>
          <option value="ASSET">Asset</option>
          <option value="LIABILITY">Liability</option>
          <option value="INCOME">Income</option>
          <option value="EXPENSE">Expense</option>
        </select>

        <div className="flex justify-end gap-2">
          <button onClick={onClose}>Cancel</button>
          <button className={BTN} onClick={save}>Save</button>
        </div>
      </div>
    </div>
  );
};


// 🔥 UPDATE BALANCE (Cash/Bank)
const BalanceModal = ({ data, onClose, onSaved }) => {
  const [amount, setAmount] = useState(data.balance);

  const save = async () => {
    await axios.post("/api/accounting/update-balance", {
      accountId: data.accountId,
      amount: Number(amount),
    });

    onSaved();
    onClose();
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <div className="bg-white p-5 rounded w-80 space-y-2">

        <h3>Update {data.accountName}</h3>

        <input type="number" className="w-full border p-2"
          value={amount}
          onChange={e => setAmount(e.target.value)} />

        <div className="flex justify-end gap-2">
          <button onClick={onClose}>Cancel</button>
          <button className={BTN} onClick={save}>Save</button>
        </div>
      </div>
    </div>
  );
};
