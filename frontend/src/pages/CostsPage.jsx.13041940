// src/pages/CostsPage.jsx
import React, { useEffect, useMemo, useState } from "react";
import axios from "axios";
import dayjs from "dayjs";
import { getToken as authGetToken } from "../utils/auth";

const CATEGORY_OPTIONS = [
  { value: "PAYROLL", label: "Payroll" },
  { value: "RENT", label: "Rent" },
  { value: "UTILITIES", label: "Utilities" },
  { value: "OTHER", label: "Other" },
];

function attachAuth() {
  const token = authGetToken();
  if (!token) return;
  axios.defaults.headers.common["Authorization"] = `Bearer ${token}`;
}

const CostsPage = () => {
  const [expenses, setExpenses] = useState([]);
  const [accounts, setAccounts] = useState([]);
  const [balances, setBalances] = useState([]);
  const [ledger, setLedger] = useState([]);
  const [selectedAccount, setSelectedAccount] = useState(null);

  const [modalOpen, setModalOpen] = useState(false);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    attachAuth();
    fetchExpenses();
    fetchAccounting();
  }, []);

  const fetchExpenses = async () => {
    const res = await axios.get("/api/expenses");
    setExpenses(res.data || []);
  };

  const fetchAccounting = async () => {
    const [accRes, balRes] = await Promise.all([
      axios.get("/api/accounting/accounts"),
      axios.get("/api/accounting/balances"),
    ]);
    setAccounts(accRes.data || []);
    setBalances(balRes.data || []);
  };

  const loadLedger = async (acc) => {
    setSelectedAccount(acc);
    const res = await axios.get(`/api/accounting/ledger/${acc.id}`);
    setLedger(res.data || []);
  };

  const handleSave = async (payload) => {
    try {
      setSaving(true);
      attachAuth();

      await axios.post("/api/expenses", payload);

      await fetchExpenses();
      await fetchAccounting();

      setModalOpen(false);
    } finally {
      setSaving(false);
    }
  };

  return (
    <div className="p-6">
      <div className="flex justify-between mb-6">
        <h1 className="text-2xl font-semibold">Accounting Dashboard</h1>
        <button
          onClick={() => setModalOpen(true)}
          className="bg-amber-500 text-white px-4 py-2 rounded"
        >
          + Add Expense
        </button>
      </div>

      {/* BALANCES */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
        {balances.map((b) => (
          <div key={b.accountId} className="bg-white p-3 rounded shadow">
            <div className="text-xs">{b.accountName}</div>
            <div className="font-bold">₹{b.balance}</div>
          </div>
        ))}
      </div>

      <div className="grid lg:grid-cols-3 gap-4">

        {/* EXPENSES */}
        <div>
          {expenses.map((e) => (
            <div key={e.id} className="bg-white p-3 rounded mb-2 shadow">
              <div className="flex justify-between">
                <div>
                  <div>{e.description}</div>
                  <div className="text-xs text-gray-500">
                    {dayjs(e.date).format("DD MMM")}
                  </div>
                </div>
                <div>₹{e.amount}</div>
              </div>
            </div>
          ))}
        </div>

        {/* ACCOUNTS */}
        <div className="bg-white p-3 rounded shadow">
          <h3 className="font-semibold mb-2">Accounts</h3>
          {accounts.map((a) => (
            <div
              key={a.id}
              onClick={() => loadLedger(a)}
              className="cursor-pointer p-2 hover:bg-gray-100"
            >
              {a.name}
            </div>
          ))}
        </div>

        {/* LEDGER */}
        <div className="bg-white p-3 rounded shadow">
          <h3 className="font-semibold mb-2">
            {selectedAccount?.name || "Ledger"}
          </h3>

          {ledger.map((l, i) => (
            <div key={i} className="flex justify-between border-b py-2 text-sm">
              <div>
                <div>{l.description}</div>
                <div className="text-xs text-gray-400">
                  {new Date(l.date).toLocaleDateString()}
                </div>
              </div>

              <div className="text-right">
                {l.debit > 0 && <div className="text-green-600">+₹{l.debit}</div>}
                {l.credit > 0 && <div className="text-red-600">-₹{l.credit}</div>}
                <div className="font-bold">₹{l.balance}</div>
              </div>
            </div>
          ))}
        </div>

      </div>

      {modalOpen && (
        <ExpenseModal
          onClose={() => setModalOpen(false)}
          onSave={handleSave}
          saving={saving}
          accounts={accounts}
        />
      )}
    </div>
  );
};

export default CostsPage;





// 🔥 NEW ADVANCED MODAL
const ExpenseModal = ({ onClose, onSave, saving, accounts }) => {
  const [form, setForm] = useState({
    description: "",
    amount: "",
    category: "RENT",
    date: dayjs().format("YYYY-MM-DD"),
    debitAccountId: "",
    creditAccountId: "",
  });

  // Auto map category → account
  useEffect(() => {
    const map = {
      RENT: "Rent Expense",
      PAYROLL: "Salary Expense",
      UTILITIES: "Utilities Expense",
    };

    const acc = accounts.find(a => a.name === map[form.category]);
    if (acc) {
      setForm(f => ({ ...f, debitAccountId: acc.id }));
    }
  }, [form.category, accounts]);

  const submit = (e) => {
    e.preventDefault();

    if (!form.description || !form.amount || !form.creditAccountId) {
      alert("Fill all required fields");
      return;
    }

    onSave({
      ...form,
      amount: Number(form.amount),
      date: dayjs(form.date).toISOString(),
    });
  };

  return (
    <div className="fixed inset-0 bg-black/40 flex items-center justify-center">
      <form onSubmit={submit} className="bg-white p-5 rounded-xl w-96 space-y-3">

        <h2 className="font-semibold text-lg">Add Expense</h2>

        <input
          placeholder="Description"
          className="w-full border p-2"
          onChange={(e) => setForm({ ...form, description: e.target.value })}
        />

        <input
          type="number"
          placeholder="Amount"
          className="w-full border p-2"
          onChange={(e) => setForm({ ...form, amount: e.target.value })}
        />

        <select
          className="w-full border p-2"
          value={form.category}
          onChange={(e) => setForm({ ...form, category: e.target.value })}
        >
          {CATEGORY_OPTIONS.map(c => (
            <option key={c.value} value={c.value}>{c.label}</option>
          ))}
        </select>

        {/* Expense Account */}
        <select
          className="w-full border p-2"
          value={form.debitAccountId}
          onChange={(e) => setForm({ ...form, debitAccountId: e.target.value })}
        >
          <option value="">Expense Account</option>
          {accounts.filter(a => a.type === "EXPENSE").map(a => (
            <option key={a.id} value={a.id}>{a.name}</option>
          ))}
        </select>

        {/* Payment Source */}
        <select
          className="w-full border p-2"
          value={form.creditAccountId}
          onChange={(e) => setForm({ ...form, creditAccountId: e.target.value })}
        >
          <option value="">Paid From</option>
          {accounts.filter(a => a.type === "ASSET").map(a => (
            <option key={a.id} value={a.id}>{a.name}</option>
          ))}
        </select>

        <button className="bg-amber-500 text-white px-4 py-2 rounded w-full">
          {saving ? "Saving..." : "Save Expense"}
        </button>
      </form>
    </div>
  );
};
