import React, { useEffect, useState } from 'react';
import { usersApi } from '../../api/users';
import Modal from '../../components/_SimpleModal'; // we'll create a tiny modal below

function DetectFields(obj) {
  if (!obj || typeof obj !== 'object') return ['id','name'];
  return Object.keys(obj);
}

export default function Page() {
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [open, setOpen] = useState(false);
  const [editing, setEditing] = useState(null);
  const [form, setForm] = useState({});

  async\ function\ load\(\)\ \{\r\n\ \ try\ \{\r\n\ \ \ \ console\.info\("\[fix]\ users\.load\(\)\ called\ -\ fetching\ direct\ from\ API"\);\r\n\ \ \ \ const\ resp\ =\ await\ fetch\("http://localhost:5001/api/users\?search=&page=1&limit=50",\ \{\ method:\ "GET"\ }\);\r\n\ \ \ \ const\ data\ =\ await\ resp\.json\(\);\r\n\ \ \ \ console\.info\("\[fix]\ raw\ API\ response:",\ data\);\r\n\r\n\ \ \ \ //\ normalize\ to\ items\ array\r\n\ \ \ \ const\ items\ =\ Array\.isArray\(data\)\ \?\ data\ :\ \(data\ &&\ \(data\.items\ \|\|\ data\.data\ \|\|\ \[]\)\)\ ;\r\n\ \ \ \ console\.info\("\[fix]\ normalized\ items\ \(length\):",\ items\.length,\ items\ &&\ items\.slice\(0,3\)\);\r\n\r\n\ \ \ \ //\ Attempt\ to\ set\ component\ state\ -\ adjust\ names\ if\ your\ state\ setter\ is\ different\r\n\ \ \ \ if\ \(typeof\ setUsers\ ===\ "function"\)\ \{\r\n\ \ \ \ \ \ setUsers\(items\);\r\n\ \ \ \ \ \ console\.info\("\[fix]\ setUsers\ called\ with\ items"\);\r\n\ \ \ \ }\ else\ \{\r\n\ \ \ \ \ \ console\.warn\("\[fix]\ setUsers\ is\ not\ defined\ in\ this\ scope\ -\ please\ confirm\ state\ setter\ name"\);\r\n\ \ \ \ }\r\n\r\n\ \ \ \ //\ optional\ metadata\ setters\ \(if\ present\)\r\n\ \ \ \ if\ \(!Array\.isArray\(data\)\)\ \{\r\n\ \ \ \ \ \ if\ \(typeof\ setTotal\ ===\ "function"\)\ setTotal\(data\.total\ \?\?\ items\.length\);\r\n\ \ \ \ \ \ if\ \(typeof\ setPage\ ===\ "function"\)\ setPage\(data\.page\ \?\?\ 1\);\r\n\ \ \ \ \ \ if\ \(typeof\ setLimit\ ===\ "function"\)\ setLimit\(data\.limit\ \?\?\ items\.length\);\r\n\ \ \ \ }\r\n\ \ }\ catch\ \(err\)\ \{\r\n\ \ \ \ console\.error\("\[fix]\ users\.load\(\)\ error:",\ err\);\r\n\ \ }\r\n}



async function load() {
  try {
    console.info("[fix] users.load() called - fetching direct from API");
    const resp = await fetch("http://localhost:5001/api/users?search=&page=1&limit=50", { method: "GET" });
    const data = await resp.json();
    console.info("[fix] raw API response:", data);

    const items = Array.isArray(data) ? data : (data && (data.items || data.data || []));
    console.info("[fix] normalized items (length):", items.length, items && items.slice(0,3));

    if (typeof setUsers === "function") {
      setUsers(items);
      console.info("[fix] setUsers called with items");
    }

    if (!Array.isArray(data)) {
      if (typeof setTotal === "function") setTotal(data.total ?? items.length);
      if (typeof setPage === "function") setPage(data.page ?? 1);
      if (typeof setLimit === "function") setLimit(data.limit ?? items.length);
    }
  } catch (err) {
    console.error("[fix] users.load() error:", err);
  }
}
