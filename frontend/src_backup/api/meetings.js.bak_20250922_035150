import { call, cleanPayload } from "./_helper";

export const meetingsApi = {
  list: () => call("/api/meetings"),

  get: (id) => call(/api/meetings/),

  create: (p) => call(/api/meetings, { method: "POST", body: JSON.stringify(cleanPayload(p)) }),

  update: async (id, p) => {
    const payload = cleanPayload(p);
    try {
      // try PUT first (standard)
      return await call(/api/meetings/, { method: "PUT", body: JSON.stringify(payload) });
    } catch (e) {
      // if server says method not allowed (405), fallback to POST to collection with id in payload
      try {
        if (e && e.status === 405) {
          const fallback = { ...payload, id: id };
          try { console.debug('[API fallback] PUT returned 405, retrying with POST to /api/meetings', fallback); } catch {}
          return await call(/api/meetings, { method: "POST", body: JSON.stringify(fallback) });
        }
      } catch (inner) {
        // rethrow original or inner error
        throw inner || e;
      }
      throw e;
    }
  },

  remove: (id) => call(/api/meetings/, { method: "DELETE" })
};